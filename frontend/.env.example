# Frontend Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit the real .env to git.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service key — ONLY used for admin operations (farm setup, animal registration).
# Exposed to the browser via Vite. Restrict via RLS policies, not secrecy.
VITE_SUPABASE_SERVICE_KEY=your-service-role-key-here
